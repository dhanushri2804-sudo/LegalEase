ENVIRONMENT=development
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=postgresql+psycopg://legalease_app:replace-with-a-long-password@localhost:5432/legalease
FRONTEND_URL=http://localhost:8501
BACKEND_URL=http://localhost:8000
JWT_SECRET_KEY=replace-with-at-least-64-random-bytes-from-a-secret-manager
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
APP_DB_ROLE=legalease_app
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=LegalEase <noreply@example.test>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=false
RATE_LIMIT_STORAGE_URI=memory://
FORCE_HTTPS=false
